// Enterprise pipeline for Stage-vhc-healthcare — generated by TestPilot.
// Plugins: Pipeline, Docker Pipeline, Credentials Binding, JUnit, HTML Publisher, Allure, Timestamper, Workspace Cleanup.
// Credentials (Manage Jenkins → Credentials, "Secret text"): jira-api-token, jira-email, zephyr-api-token, sauce-username, sauce-access-key, aws-access-key-id, aws-secret-access-key, slack-webhook-url
pipeline {
  agent { docker { image 'mcr.microsoft.com/playwright:v1.63.0-noble' args '--ipc=host' } }
  options {
    timeout(time: 90, unit: 'MINUTES')
    timestamps()
    disableConcurrentBuilds(abortPrevious: true)
    buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '10'))
  }
  triggers { cron('H 2 * * 1-5') }   // nightly regression on weekdays
  parameters {
    choice(name: 'TEST_ENV', choices: ['qa', 'dev', 'uat', 'stage'], description: 'Target environment (.env.<name>)')
    choice(name: 'SUITE', choices: ['smoke', 'critical', 'regression', 'api', 'all'], description: 'Tag to run')
    choice(name: 'BROWSER', choices: ['chromium'], description: 'Browser / Playwright project')
    choice(name: 'RUN_ON', choices: ['local', 'saucelabs'], description: 'Execution target')
    choice(name: 'INTEGRATIONS_MODE', choices: ['mock', 'live'], description: 'mock = bundled dummy APIs, live = real Jira / Zephyr / …')
    booleanParam(name: 'PUBLISH_RESULTS', defaultValue: true, description: 'Publish to Zephyr / Jira / S3 / GitHub / chat')
  }
  environment {
    TEST_ENV = "${params.TEST_ENV}"
    RUN_ON = "${params.RUN_ON}"
    INTEGRATIONS_MODE = "${params.INTEGRATIONS_MODE}"
    PUBLISH_RESULTS = "${params.PUBLISH_RESULTS}"
    RUN_NAME = "STAG-${params.TEST_ENV}-${params.SUITE}-#${env.BUILD_NUMBER}"
    JIRA_API_TOKEN = credentials('jira-api-token')
    JIRA_EMAIL = credentials('jira-email')
    ZEPHYR_API_TOKEN = credentials('zephyr-api-token')
    SAUCE_USERNAME = credentials('sauce-username')
    SAUCE_ACCESS_KEY = credentials('sauce-access-key')
    AWS_ACCESS_KEY_ID = credentials('aws-access-key-id')
    AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
    SLACK_WEBHOOK_URL = credentials('slack-webhook-url')
  }
  stages {
    stage('Checkout') { steps { checkout scm } }
    stage('Install') { steps { sh 'npm ci' } }
    stage('Static checks') { steps { sh 'npx tsc --noEmit'; sh 'npx eslint .' } }
    stage('Test') {
      steps {
        script {
          if (params.RUN_ON == 'saucelabs') {
            sh 'npx saucectl run --config .sauce/config.yml'
          } else if (params.RUN_ON == 'browserstack') {
            sh "npx browserstack-node-sdk playwright test ${params.SUITE == 'all' ? '' : '--grep @' + params.SUITE}"
          } else {
            sh "npx playwright test ${params.SUITE == 'all' ? '' : '--grep @' + params.SUITE} --project=${params.BROWSER}"
          }
        }
      }
    }
    stage('Quality gate') {
      when { expression { params.SUITE != 'smoke' } }
      steps {
        sh '''
node -e '
const fs=require("fs");const glob="reports/junit.xml";const files=glob.includes("*")?fs.readdirSync(glob.split("*")[0]).filter(f=>f.endsWith(".xml")).map(f=>glob.split("*")[0]+f):[glob];
let tests=0,failures=0,critical=0;for(const f of files){if(!fs.existsSync(f))continue;const x=fs.readFileSync(f,"utf8");tests+=Number((x.match(/tests="(\d+)"/)||[0,0])[1]);failures+=Number((x.match(/failures="(\d+)"/)||[0,0])[1]);critical+=(x.match(/<testcase[^>]*@critical[^>]*>\s*<failure/g)||[]).length;}
const pass=tests?Math.round((tests-failures)/tests*100):0;
console.log("Tests:",tests,"Failures:",failures,"Pass rate:",pass+"%","Critical failures:",critical);
if(critical>0){console.error("Build blocked. Reason: "+critical+" critical test failure(s).");process.exit(1)}
if(pass<95){console.error("Build blocked. Reason: pass rate "+pass+"% < 95%.");process.exit(1)}
console.log("Quality gate PASSED");'
'''
      }
    }
  }
  post {
    always {
      junit allowEmptyResults: true, testResults: 'reports/junit.xml'
      publishHTML(target: [reportDir: 'reports/html', reportFiles: 'index.html', reportName: 'Playwright Report', keepAll: true, alwaysLinkToLastBuild: true, allowMissing: true])
      allure includeProperties: false, results: [[path: 'reports/allure-results']]
      archiveArtifacts artifacts: 'reports/**, test-results/**, logs/**', allowEmptyArchive: true
    }
    cleanup { cleanWs(deleteDirs: true, notFailBuild: true) }
  }
}
