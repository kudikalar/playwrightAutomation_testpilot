# DEV environment — placeholders only. Real values come from your secret store / CI secrets.
TEST_ENV=dev
BASE_URL=https://dev.example.com
API_URL=
LOG_LEVEL=info

# --- Integrations (mock = bundled dummy API server, live = real services)
INTEGRATIONS_MODE=mock
MOCK_INTEGRATIONS_PORT=4599
# local | saucelabs | browserstack
RUN_ON=local
RUN_NAME=STAG-dev-regression
# false disables every publisher (local debugging)
PUBLISH_RESULTS=true

# --- Jira (REST v3)
JIRA_ENABLED=true
JIRA_BASE_URL=http://localhost:4599
JIRA_EMAIL=automation@example-test.local
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=STAG
JIRA_ISSUE_TYPE=Bug
# file a bug for every new failure signature
JIRA_CREATE_BUGS=true
JIRA_LABELS=automation,testpilot
JIRA_PRIORITY_MAP=Critical:Highest,High:High,Medium:Medium,Low:Low

# --- Zephyr Scale (Cloud API v2)
ZEPHYR_ENABLED=true
ZEPHYR_BASE_URL=http://localhost:4599/v2
ZEPHYR_API_TOKEN=
ZEPHYR_PROJECT_KEY=STAG
ZEPHYR_CYCLE_NAME=
# create test cases that have no mapping yet
ZEPHYR_CREATE_MISSING_CASES=true

# --- Sauce Labs
SAUCE_USERNAME=
SAUCE_ACCESS_KEY=
SAUCE_REGION=us-west-1
SAUCE_TUNNEL_NAME=
SAUCE_BUILD=

# --- AWS (S3 report archive + Secrets Manager)
AWS_REGION=ap-south-1
AWS_PROFILE=
AWS_S3_BUCKET=stage-vhc-healthcare-test-reports
AWS_S3_PREFIX=stage-vhc-healthcare/dev
AWS_S3_UPLOAD=true
# env | aws
SECRETS_PROVIDER=env
AWS_SECRET_ID=stage-vhc-healthcare/dev/automation

# --- GitHub
GITHUB_API_URL=http://localhost:4599
GITHUB_TOKEN=
GITHUB_REPOSITORY=your-org/your-repo
GITHUB_PR_NUMBER=
GITHUB_SHA=

# --- Slack
SLACK_WEBHOOK_URL=http://localhost:4599/hooks/slack

# --- Notification policy
# always | failure
NOTIFY_ON=always
