{
  "name": "stage-vhc-healthcare-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Automation framework for Stage-vhc-healthcare (generated by TestPilot)",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:critical": "playwright test --grep @critical",
    "test:regression": "playwright test --grep @regression",
    "test:api": "playwright test --grep @api",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report reports/html",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "report:allure": "allure generate reports/allure-results -o reports/allure --clean",
    "mock:integrations": "node tools/mock-integrations/server.cjs",
    "test:live-integrations": "INTEGRATIONS_MODE=live playwright test",
    "test:saucelabs": "npx --yes saucectl run --config .sauce/config.yml",
    "test:docker": "docker compose up --build --abort-on-container-exit tests"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "dotenv": "16.4.5",
    "@axe-core/playwright": "4.10.1",
    "typescript": "5.6.3",
    "@types/node": "22.10.2",
    "allure-playwright": "3.0.9",
    "eslint": "9.16.0",
    "typescript-eslint": "8.18.0",
    "prettier": "3.4.2"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "3.700.0",
    "@aws-sdk/client-secrets-manager": "3.700.0"
  },
  "engines": {
    "node": ">=20"
  }
}
