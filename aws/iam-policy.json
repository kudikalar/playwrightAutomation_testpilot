{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UploadReports",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::stage-vhc-healthcare-test-reports/*"
    },
    {
      "Sid": "ReadAutomationSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": "arn:aws:secretsmanager:*:*:secret:stage-vhc-healthcare/*"
    }
  ]
}
